// Backup-Tool: let members of the "backup-tool" group mount the backup drive
// via udisks2 without an interactive polkit prompt.
//
// The scheduled backup runs as a systemd *user* service. When no active
// graphical session is present (screen locked, logged out with linger, early
// morning timer run) udisks2's default for filesystem-mount is auth_admin,
// which fails with "Not authorized to perform operation" because there is no
// polkit agent to answer the prompt.
//
// Which udisks2 action is requested depends on the caller:
//  - filesystem-mount: the caller has a session on the device's seat (e.g. you
//    are logged in at the console).
//  - filesystem-mount-other-seat: the caller has NO session on the device's seat.
//    This is exactly the unattended case -- the timer firing at boot, after a
//    resume, or while nobody is logged in -- so it must be granted too, or the
//    backup fails with "Not authorized" whenever the drive is not already
//    mounted and nobody is at the console.
//  - filesystem-mount-system: devices udisks2 classifies as system devices
//    (HintSystem=true: internal disks, anything in fstab).
//
// Scope is deliberately narrow:
//  - Only filesystem-mount and filesystem-mount-other-seat are granted.
//    filesystem-mount-system is NOT, so internal/system devices still need
//    administrator authentication.
//  - Unmount, eject, format and every other udisks2 action are not granted.
//
// If your backup drive is an internal disk that udisks2 treats as a system
// device, add a separate local rule for it (match action.lookup("device")) in
// /etc/polkit-1/rules.d/ rather than widening this one.
//
// Add a user with:  sudo usermod -aG backup-tool <user>
polkit.addRule(function(action, subject) {
    if ((action.id == "org.freedesktop.udisks2.filesystem-mount" ||
         action.id == "org.freedesktop.udisks2.filesystem-mount-other-seat") &&
        subject.isInGroup("backup-tool")) {
        return polkit.Result.YES;
    }
});
