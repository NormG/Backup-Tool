# Signed with Backup-Tool RPM key (see packaging/backup-tool.gpg.asc).
#   sudo dnf install rpm-sign
#   rpmsign --addsign ~/rpmbuild/RPMS/x86_64/backup-tool-*.rpm
#   sudo rpmkeys --import packaging/backup-tool.gpg.asc
#   rpm -K backup-tool-*.rpm
Name:           backup-tool
Version:        0.1.13
Release:        2%{?dist}
Summary:        Backup-Tool — GTK4 rsync backup manager with systemd timer

License:        GPL-3.0-or-later
URL:            https://github.com/NormG/Backup-Tool
# RPM installs before 0.1.7 shipped as home-backup; Obsoletes lets dnf upgrade in place.
Obsoletes:      home-backup < 0.1.8
Provides:       home-backup = %{version}-%{release}

# Source0: project source tarball
# Source1: vendored Rust dependencies (generated by 'cargo vendor')
Source0:        %{name}-%{version}.tar.gz
Source1:        %{name}-%{version}-vendor.tar.gz
# Source2: sysusers.d definition for the backup-tool group (polkit rule below keys on it)
Source2:        %{name}.sysusers

# ── Build dependencies ────────────────────────────────────────────────────────
BuildRequires:  rust >= 1.70
BuildRequires:  cargo
BuildRequires:  pkgconf-pkg-config
BuildRequires:  gtk4-devel
BuildRequires:  glib2-devel
BuildRequires:  gcc
BuildRequires:  systemd-rpm-macros

# ── Runtime dependencies ──────────────────────────────────────────────────────
Requires:       rsync
Requires:       gtk4
Requires:       hicolor-icon-theme
# Owns /usr/share/polkit-1/rules.d where the mount rule is installed
Requires:       polkit
%{?sysusers_requires_compat}
# udisks2 enables auto-mounting the backup drive by UUID (optional but recommended)
Recommends:     udisks2

%description
Backup-Tool is a GTK4 desktop application for Fedora Linux that backs up
personal files to an external drive using rsync atomic backups and a
systemd user timer.

Features:
  - Guided 7-page install wizard with live drive detection
  - Seven-tab management window (Dashboard, Schedule, Excludes,
    Paths, Log, Btrfs, About)
  - Atomic rsync backups staged in .inprogress-* and renamed on success
  - Hardlinked incrementals via --link-dest; only deltas consume new space
  - Configurable full/incremental schedule, retention, and exclude patterns
  - Systemd user-level timer — no root required
  - Nautilus sidebar bookmark management
  - Same-filesystem destination guard

# ── Prep ─────────────────────────────────────────────────────────────────────
# -a 1  unpacks Source1 (vendor tarball) after changing into the build dir
%prep
%autosetup -n %{name}-%{version} -a 1

# Configure cargo to use the local vendor directory instead of crates.io.
mkdir -p .cargo
cat > .cargo/config.toml << 'CARGO_EOF'
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "vendor"
CARGO_EOF

# ── Build ─────────────────────────────────────────────────────────────────────
%build
# Keep artifacts under the source tree (rpmbuild and CI may set CARGO_TARGET_DIR).
export CARGO_TARGET_DIR=$PWD/target
cargo build --release --offline

# ── Install ───────────────────────────────────────────────────────────────────
%install
export CARGO_TARGET_DIR=$PWD/target
# Binary
install -Dm 0755 "$CARGO_TARGET_DIR/release/%{name}" \
    %{buildroot}%{_bindir}/%{name}

# Icons
install -Dm 0644 assets/%{name}.png \
    %{buildroot}%{_datadir}/icons/hicolor/128x128/apps/%{name}.png
install -Dm 0644 assets/%{name}.svg \
    %{buildroot}%{_datadir}/icons/hicolor/scalable/apps/%{name}.svg

# Desktop launcher — substitute @EXEC@ with the installed binary path
install -dm 0755 %{buildroot}%{_datadir}/applications
sed 's|@EXEC@|%{_bindir}/%{name}|g' assets/%{name}.desktop \
    > %{buildroot}%{_datadir}/applications/%{name}.desktop

# Assets (runtime lookup: icon PNG next to binary in /usr/share/backup-tool/assets/)
install -dm 0755 %{buildroot}%{_datadir}/%{name}/assets
install -m 0644 assets/backup-tool.png assets/backup-tool.svg assets/deviation-tape.png \
    %{buildroot}%{_datadir}/%{name}/assets/
install -m 0644 assets/backup-tool.desktop \
    %{buildroot}%{_datadir}/%{name}/assets/

# Polkit rule: members of the backup-tool group may mount the backup drive
# via udisks2 without a prompt (needed for unattended systemd user-timer runs).
install -Dm 0644 packaging/50-%{name}.rules \
    %{buildroot}%{_datadir}/polkit-1/rules.d/50-%{name}.rules

# sysusers.d: declaratively creates the backup-tool group
install -Dm 0644 %{SOURCE2} %{buildroot}%{_sysusersdir}/%{name}.conf

# License and documentation
install -Dm 0644 LICENSE \
    %{buildroot}%{_licensedir}/%{name}/LICENSE
install -Dm 0644 README.md \
    %{buildroot}%{_pkgdocdir}/README.md

# ── Pre-install: create the backup-tool group ───────────────────────────────
%pre
%sysusers_create_package %{name} %{SOURCE2}

# ── Post-install: legacy home-backup → Backup-Tool migrations ───────────────
%post
gtk-update-icon-cache -f -t %{_datadir}/icons/hicolor &>/dev/null || :
update-desktop-database -q %{_datadir}/applications          &>/dev/null || :
# Create Btrfs snapshot directory, world-writable with sticky bit (like /tmp)
# so any user can create their own snapshots without needing root.
mkdir -p /home/.snapshots 2>/dev/null || :
chmod 1777 /home/.snapshots 2>/dev/null || :

# Remove pre-0.1.11 cruft from older asset installs (blind cp -r assets/).
rm -f %{_datadir}/%{name}/assets/home-backup.png 2>/dev/null || :
rm -rf %{_datadir}/%{name}/assets/icon-drafts 2>/dev/null || :

migrate_legacy_home_backup_units() {
    local user="$1"
    local home
    home=$(getent passwd "$user" | cut -d: -f6) || return 0
    [ -n "$home" ] || return 0
    [ -d "$home" ] || return 0

    local ud="$home/.config/systemd/user"
    if [ -f "$ud/home-backup.timer" ] || [ -f "$ud/home-backup.service" ]; then
        runuser -u "$user" -- systemctl --user disable --now home-backup.timer \
            &>/dev/null || true
        rm -f "$ud/home-backup.service" "$ud/home-backup.timer"
        runuser -u "$user" -- systemctl --user daemon-reload &>/dev/null || true
    fi

    rm -f "$home/.local/share/applications/home-backup.desktop"
}

migrate_backup_tool_user_files() {
    local user="$1"
    local home
    home=$(getent passwd "$user" | cut -d: -f6) || return 0
    [ -n "$home" ] || return 0

    local svc="$home/.config/systemd/user/backup-tool.service"
    local bookmarks="$home/.config/gtk-3.0/bookmarks"
    local changed=false

    if [ -f "$svc" ]; then
        if grep -q '--backup' "$svc" 2>/dev/null; then
            sed -i 's|--backup auto|backup auto|g; s|--backup full|backup full|g; s|--backup incremental|backup incremental|g; s|--backup inc|backup inc|g' "$svc"
            if ! grep -q 'TimeoutStartSec=' "$svc" 2>/dev/null; then
                sed -i '/^TimeoutStopSec=/i TimeoutStartSec=infinity' "$svc"
            fi
            changed=true
        fi
        if grep -q 'Description=Home Directory Backup' "$svc" 2>/dev/null; then
            sed -i 's|^Description=Home Directory Backup|Description=Backup-Tool automatic backup|' "$svc"
            changed=true
        fi
    fi

    if [ -f "$bookmarks" ] && grep -q ' Home Backups$' "$bookmarks" 2>/dev/null; then
        sed -i 's/ Home Backups$/ Backup-Tool/' "$bookmarks"
    fi

    if [ "$changed" = true ]; then
        runuser -u "$user" -- systemctl --user daemon-reload &>/dev/null || true
    fi
}

if [ -n "${SUDO_USER:-}" ]; then
    # Let the installing user mount the backup drive unattended (see polkit rule).
    if [ "$SUDO_USER" != root ] && getent group backup-tool &>/dev/null; then
        usermod -aG backup-tool "$SUDO_USER" &>/dev/null || :
    fi
    migrate_legacy_home_backup_units "$SUDO_USER"
    migrate_backup_tool_user_files "$SUDO_USER"
fi

%postun
gtk-update-icon-cache -f -t %{_datadir}/icons/hicolor &>/dev/null || :
update-desktop-database -q %{_datadir}/applications          &>/dev/null || :

# ── File manifest ─────────────────────────────────────────────────────────────
%files
%license LICENSE
%doc README.md
%{_bindir}/%{name}
%{_datadir}/applications/%{name}.desktop
%{_datadir}/icons/hicolor/128x128/apps/%{name}.png
%{_datadir}/icons/hicolor/scalable/apps/%{name}.svg
%{_datadir}/%{name}/
%{_datadir}/polkit-1/rules.d/50-%{name}.rules
%{_sysusersdir}/%{name}.conf

